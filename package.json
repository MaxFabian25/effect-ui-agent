{
  "name": "effect-ui-agent",
  "version": "0.1.0",
  "description": "Production end-user agent bridge and WebMCP layer for @effect/ui",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxFabian25/effect-ui-agent.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "bun": "./src/testing.ts",
      "import": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      }
    }
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "effect-tsgo tsc --noEmit",
    "lint": "effect-tsgo oxlint --type-aware",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" package.json .oxlintrc.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" package.json .oxlintrc.json tsconfig.json",
    "check": "bun run typecheck && bun run lint",
    "build": "tsc -p tsconfig.build.json",
    "doctor": "effect-doctor --strict .",
    "verify:faults": "bun scripts/verify-faults.ts",
    "test": "bun test",
    "verify": "bun run check && bun run format:check && bun run build && bun test && bun run doctor && bun run verify:faults"
  },
  "peerDependencies": {
    "@effect/ui": "*",
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.7",
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@fb618d4",
    "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@fb618d4",
    "@oxlint/plugins": "1.95.0",
    "@types/bun": "1.4.5",
    "effect": "4.1.5",
    "effect-config": "github:MaxFabian25/effect-config#a4ebfb903556d2a48df17f0eb223f9cd32c9d81e",
    "happy-dom": "21.0.4",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
